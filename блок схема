    A[Начало]
    B[Получение команды /start]
    C[Отправка главного меню]
    D{Выбор пользователя}
    E["Расчет обоев"]
    F["Расчет краски"]
    G["Расчет плитки"]
    H[Запрос размеров комнаты]
    I[Ввод размеров]
    J[Расчет необходимых материалов]
    K[Отправка результата]
    L[Возврат к главному меню]

    A --> B --> C
    C --> D
    D -- "Расчет обоев" --> E
    D -- "Расчет краски" --> F
    D -- "Расчет плитки" --> G
    E --> H --> I --> J --> K --> L
    F --> H --> I --> J --> K --> L
    G --> H --> I --> J --> K --> L
    L --> C
